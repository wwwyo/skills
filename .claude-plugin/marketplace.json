{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "wwwyo",
  "description": "wwwyo の agent skills。core は cloud（claude.ai）と local の両方、design は UI の見た目・動き・モバイル・3D（cloud と local の両方）、local は手元の開発環境専用",
  "owner": {
    "name": "wwwyo",
    "url": "https://github.com/wwwyo"
  },
  "plugins": [
    {
      "name": "core",
      "source": "./plugins/core",
      "strict": false,
      "description": "環境に依存しない汎用 skill。claude.ai アカウントと local の両方で使う",
      "skills": [
        "./skills/agent-friendly-cli",
        "./skills/architect",
        "./skills/benchmark-checklist",
        "./skills/blast-radius",
        "./skills/catch-up",
        "./skills/correct",
        "./skills/create-formal-verification-skill",
        "./skills/create-verification-skill",
        "./skills/database-design",
        "./skills/document",
        "./skills/domain-modeling",
        "./skills/e2e",
        "./skills/figure-it-out",
        "./skills/gh-stack",
        "./skills/grill-with-docs",
        "./skills/grilling",
        "./skills/interrogate",
        "./skills/learn",
        "./skills/maintain-formal-verification-skill",
        "./skills/maintain-verification-skill",
        "./skills/media-generation",
        "./skills/mode",
        "./skills/no-comments",
        "./skills/prd",
        "./skills/principle-attack-the-premise",
        "./skills/principle-boundary-discipline",
        "./skills/principle-build-the-lever",
        "./skills/principle-encode-lessons-in-structure",
        "./skills/principle-exhaust-the-design-space",
        "./skills/principle-experience-first",
        "./skills/principle-explain-the-number",
        "./skills/principle-fix-root-causes",
        "./skills/principle-foundational-thinking",
        "./skills/principle-laziness-protocol",
        "./skills/principle-make-operations-idempotent",
        "./skills/principle-migrate-callers-then-delete-legacy-apis",
        "./skills/principle-minimize-reader-load",
        "./skills/principle-model-the-domain",
        "./skills/principle-never-block-on-the-human",
        "./skills/principle-outcome-oriented-execution",
        "./skills/principle-prove-it-works",
        "./skills/principle-redesign-from-first-principles",
        "./skills/principle-separate-before-serializing-shared-state",
        "./skills/principle-sequence-verifiable-units",
        "./skills/principle-subtract-before-you-add",
        "./skills/principle-test-behavior-not-implementation",
        "./skills/principle-type-system-discipline",
        "./skills/project-setup",
        "./skills/reframe",
        "./skills/sharpen",
        "./skills/solo-product",
        "./skills/tdd",
        "./skills/technical-writing",
        "./skills/typescript-best-practices",
        "./skills/unslop-writing"
      ],
      "mcpServers": {
        "mcphub": {
          "type": "http",
          "url": "https://mcp.wwwyo.dev/mcp"
        },
        "mcp-media": {
          "type": "http",
          "url": "https://mcp-media.wwwyo.dev/mcp"
        }
      }
    },
    {
      "name": "design",
      "source": "./plugins/design",
      "strict": false,
      "description": "UI の見た目・動き・モバイルの挙動・3D を扱う skill（入口は design-mode。unslop・design-md・emilkowalski/skills・CloudAI-X/threejs-skills）。claude.ai アカウントと local の両方で使う",
      "skills": [
        "./skills/animate",
        "./skills/animation-performance",
        "./skills/apple-design",
        "./skills/break-ui",
        "./skills/choreograph",
        "./skills/design-md",
        "./skills/design-mode",
        "./skills/emil-design-eng",
        "./skills/find-animation-opportunities",
        "./skills/gestures",
        "./skills/improve-animations",
        "./skills/mobile-native",
        "./skills/pick-ui-library",
        "./skills/remove-animations",
        "./skills/review-animations",
        "./skills/threejs-animation",
        "./skills/threejs-asset-pipeline",
        "./skills/threejs-fundamentals",
        "./skills/threejs-geometry",
        "./skills/threejs-interaction",
        "./skills/threejs-lighting",
        "./skills/threejs-loaders",
        "./skills/threejs-materials",
        "./skills/threejs-performance",
        "./skills/threejs-postprocessing",
        "./skills/threejs-react-three-fiber",
        "./skills/threejs-shaders",
        "./skills/threejs-textures",
        "./skills/unslop"
      ]
    },
    {
      "name": "local",
      "source": "./plugins/local",
      "strict": false,
      "description": "手元の開発環境（Orca・dotfiles・mise・ローカル CLI）を前提にする skill。Claude Code では手元の Blender・OpenScreen を操作する MCP も載せる。local 専用",
      "skills": [
        "./skills/agent-browser",
        "./skills/apple-container",
        "./skills/cloudflare",
        "./skills/delegate",
        "./skills/ingest-to-markdown",
        "./skills/pr-auto-merge",
        "./skills/secret-env",
        "./skills/skillctrl",
        "./skills/statechart",
        "./skills/typesafe-ai"
      ],
      "mcpServers": {
        "blender": {
          "command": "uvx",
          "args": [
            "mcp-for-blender==2.2.7"
          ],
          "env": {
            "DISABLE_TELEMETRY": "true"
          }
        },
        "openscreen": {
          "type": "http",
          "url": "http://127.0.0.1:47821/mcp",
          "headers": {
            "Authorization": "Bearer ${user_config.openscreen_token}"
          }
        }
      },
      "userConfig": {
        "openscreen_token": {
          "type": "string",
          "title": "OpenScreen MCP token",
          "description": "OpenScreen の Settings → MCP Server に表示される bearer token。Keychain に保存される",
          "sensitive": true
        }
      }
    }
  ]
}
