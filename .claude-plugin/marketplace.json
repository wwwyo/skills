{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "wwwyo",
  "description": "wwwyo の agent skills。core は cloud（claude.ai）と local の両方、design は UI の見た目・動き・モバイル・3D（cloud と local の両方）、local は手元の開発環境専用",
  "owner": {
    "name": "wwwyo",
    "url": "https://github.com/wwwyo"
  },
  "plugins": [
    {
      "name": "core",
      "source": "./",
      "strict": false,
      "description": "環境に依存しない汎用 skill。claude.ai アカウントと local の両方で使う",
      "skills": [
        "./.agents/skills/agent-friendly-cli",
        "./.agents/skills/architect",
        "./.agents/skills/benchmark-checklist",
        "./.agents/skills/blast-radius",
        "./.agents/skills/catch-up",
        "./.agents/skills/correct",
        "./.agents/skills/create-formal-verification-skill",
        "./.agents/skills/create-verification-skill",
        "./.agents/skills/database-design",
        "./.agents/skills/document",
        "./.agents/skills/domain-modeling",
        "./.agents/skills/e2e",
        "./.agents/skills/figure-it-out",
        "./.agents/skills/grill-with-docs",
        "./.agents/skills/grilling",
        "./.agents/skills/interrogate",
        "./.agents/skills/learn",
        "./.agents/skills/maintain-formal-verification-skill",
        "./.agents/skills/maintain-verification-skill",
        "./.agents/skills/media-generation",
        "./.agents/skills/mode",
        "./.agents/skills/no-comments",
        "./.agents/skills/prd",
        "./.agents/skills/principle-attack-the-premise",
        "./.agents/skills/principle-boundary-discipline",
        "./.agents/skills/principle-build-the-lever",
        "./.agents/skills/principle-encode-lessons-in-structure",
        "./.agents/skills/principle-exhaust-the-design-space",
        "./.agents/skills/principle-experience-first",
        "./.agents/skills/principle-explain-the-number",
        "./.agents/skills/principle-fix-root-causes",
        "./.agents/skills/principle-foundational-thinking",
        "./.agents/skills/principle-laziness-protocol",
        "./.agents/skills/principle-make-operations-idempotent",
        "./.agents/skills/principle-migrate-callers-then-delete-legacy-apis",
        "./.agents/skills/principle-minimize-reader-load",
        "./.agents/skills/principle-model-the-domain",
        "./.agents/skills/principle-never-block-on-the-human",
        "./.agents/skills/principle-outcome-oriented-execution",
        "./.agents/skills/principle-prove-it-works",
        "./.agents/skills/principle-redesign-from-first-principles",
        "./.agents/skills/principle-separate-before-serializing-shared-state",
        "./.agents/skills/principle-sequence-verifiable-units",
        "./.agents/skills/principle-subtract-before-you-add",
        "./.agents/skills/principle-test-behavior-not-implementation",
        "./.agents/skills/principle-type-system-discipline",
        "./.agents/skills/project-setup",
        "./.agents/skills/reframe",
        "./.agents/skills/sharpen",
        "./.agents/skills/skill-structure",
        "./.agents/skills/solo-product",
        "./.agents/skills/tdd",
        "./.agents/skills/technical-writing",
        "./.agents/skills/typescript-best-practices",
        "./.agents/skills/unslop-writing"
      ],
      "mcpServers": {
        "mcphub": {
          "type": "http",
          "url": "https://mcp.wwwyo.dev/mcp"
        },
        "mcp-media": {
          "type": "http",
          "url": "https://mcp-media.wwwyo.dev/mcp"
        }
      }
    },
    {
      "name": "design",
      "source": "./",
      "strict": false,
      "description": "UI の見た目・動き・モバイルの挙動・3D を扱う skill（入口は design-mode。unslop・design-md・emilkowalski/skills・CloudAI-X/threejs-skills）。claude.ai アカウントと local の両方で使う",
      "skills": [
        "./.agents/skills/animate",
        "./.agents/skills/animation-performance",
        "./.agents/skills/apple-design",
        "./.agents/skills/break-ui",
        "./.agents/skills/choreograph",
        "./.agents/skills/design-md",
        "./.agents/skills/design-mode",
        "./.agents/skills/emil-design-eng",
        "./.agents/skills/find-animation-opportunities",
        "./.agents/skills/gestures",
        "./.agents/skills/improve-animations",
        "./.agents/skills/mobile-native",
        "./.agents/skills/pick-ui-library",
        "./.agents/skills/remove-animations",
        "./.agents/skills/review-animations",
        "./.agents/skills/threejs-animation",
        "./.agents/skills/threejs-asset-pipeline",
        "./.agents/skills/threejs-fundamentals",
        "./.agents/skills/threejs-geometry",
        "./.agents/skills/threejs-interaction",
        "./.agents/skills/threejs-lighting",
        "./.agents/skills/threejs-loaders",
        "./.agents/skills/threejs-materials",
        "./.agents/skills/threejs-performance",
        "./.agents/skills/threejs-postprocessing",
        "./.agents/skills/threejs-react-three-fiber",
        "./.agents/skills/threejs-shaders",
        "./.agents/skills/threejs-textures",
        "./.agents/skills/unslop"
      ]
    },
    {
      "name": "local",
      "source": "./",
      "strict": false,
      "description": "手元の開発環境（Orca・dotfiles・mise・ローカル CLI）を前提にする skill。Claude Code では手元の Blender・OpenScreen を操作する MCP も載せる。local 専用",
      "skills": [
        "./.agents/skills/agent-browser",
        "./.agents/skills/apple-container",
        "./.agents/skills/cloudflare",
        "./.agents/skills/delegate",
        "./.agents/skills/dev-env",
        "./.agents/skills/gh-stack",
        "./.agents/skills/ingest-to-markdown",
        "./.agents/skills/langfuse",
        "./.agents/skills/pr-auto-merge",
        "./.agents/skills/secret-env",
        "./.agents/skills/skillctrl",
        "./.agents/skills/statechart",
        "./.agents/skills/typesafe-ai",
        "./.agents/skills/void"
      ],
      "mcpServers": {
        "blender": {
          "command": "uvx",
          "args": [
            "mcp-for-blender==2.2.7"
          ],
          "env": {
            "DISABLE_TELEMETRY": "true"
          }
        },
        "openscreen": {
          "type": "http",
          "url": "http://127.0.0.1:47821/mcp",
          "headers": {
            "Authorization": "Bearer ${user_config.openscreen_token}"
          }
        }
      },
      "userConfig": {
        "openscreen_token": {
          "type": "string",
          "title": "OpenScreen MCP token",
          "description": "OpenScreen の Settings → MCP Server に表示される bearer token。Keychain に保存される",
          "sensitive": true
        }
      }
    }
  ]
}
