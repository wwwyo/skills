{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "wwwyo",
  "description": "wwwyo の agent skills。core は cloud（claude.ai）と local の両方、design は UI の見た目・動き・モバイル、3d は three.js の 3D 表現（どちらも cloud と local の両方）、local は手元の開発環境専用",
  "owner": {
    "name": "wwwyo",
    "url": "https://github.com/wwwyo"
  },
  "plugins": [
    {
      "name": "core",
      "source": "./",
      "strict": false,
      "description": "環境に依存しない汎用 skill。claude.ai アカウントと local の両方で使う",
      "skills": [
        "./.agents/skills/agent-friendly-cli",
        "./.agents/skills/ce-simplify-code",
        "./.agents/skills/document",
        "./.agents/skills/domain-modeling",
        "./.agents/skills/e2e",
        "./.agents/skills/grill-with-docs",
        "./.agents/skills/grilling",
        "./.agents/skills/implement",
        "./.agents/skills/japanese-tech-writing",
        "./.agents/skills/learn",
        "./.agents/skills/media-generation",
        "./.agents/skills/pr",
        "./.agents/skills/prd",
        "./.agents/skills/project-setup",
        "./.agents/skills/prototype",
        "./.agents/skills/skill-structure",
        "./.agents/skills/solo-product"
      ]
    },
    {
      "name": "design",
      "source": "./",
      "strict": false,
      "description": "UI の見た目・動き・モバイルの挙動を扱う skill（unslop・design-md・emilkowalski/skills）。claude.ai アカウントと local の両方で使う",
      "skills": [
        "./.agents/skills/animate",
        "./.agents/skills/animation-performance",
        "./.agents/skills/apple-design",
        "./.agents/skills/break-ui",
        "./.agents/skills/choreograph",
        "./.agents/skills/design-md",
        "./.agents/skills/emil-design-eng",
        "./.agents/skills/find-animation-opportunities",
        "./.agents/skills/gestures",
        "./.agents/skills/improve-animations",
        "./.agents/skills/mobile-native",
        "./.agents/skills/pick-ui-library",
        "./.agents/skills/remove-animations",
        "./.agents/skills/review-animations",
        "./.agents/skills/unslop"
      ]
    },
    {
      "name": "3d",
      "source": "./",
      "strict": false,
      "description": "three.js・React Three Fiber で 3D を作る skill（CloudAI-X/threejs-skills）。claude.ai アカウントと local の両方で使う",
      "skills": [
        "./.agents/skills/threejs-animation",
        "./.agents/skills/threejs-asset-pipeline",
        "./.agents/skills/threejs-fundamentals",
        "./.agents/skills/threejs-geometry",
        "./.agents/skills/threejs-interaction",
        "./.agents/skills/threejs-lighting",
        "./.agents/skills/threejs-loaders",
        "./.agents/skills/threejs-materials",
        "./.agents/skills/threejs-performance",
        "./.agents/skills/threejs-postprocessing",
        "./.agents/skills/threejs-react-three-fiber",
        "./.agents/skills/threejs-shaders",
        "./.agents/skills/threejs-textures"
      ]
    },
    {
      "name": "local",
      "source": "./",
      "strict": false,
      "description": "手元の開発環境（Orca・dotfiles・mise・ローカル CLI）を前提にする skill。local 専用",
      "skills": [
        "./.agents/skills/agent-browser",
        "./.agents/skills/apple-container",
        "./.agents/skills/cloudflare",
        "./.agents/skills/delegate",
        "./.agents/skills/dev-env",
        "./.agents/skills/gh-stack",
        "./.agents/skills/ingest-to-markdown",
        "./.agents/skills/langfuse",
        "./.agents/skills/pr-auto-merge",
        "./.agents/skills/secret-env",
        "./.agents/skills/skillctrl",
        "./.agents/skills/typesafe-ai"
      ]
    }
  ]
}
